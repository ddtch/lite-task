# lite-task environment variables
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# Base URL of your lite-task instance (used by the Telegram bot to reach the API)
LITE_TASK_URL=http://localhost:8011

# ── Deployment (docker compose) ───────────────────────────────────────────────
# Which published image tag to run. `latest` follows main; pin a release
# (e.g. v1.2.3) on a server you want to upgrade deliberately.
LITE_TASK_TAG=latest

# Host port and interface the web app is published on. The default binds to
# loopback only, so a reverse proxy on the host is what faces the internet.
# Set BIND_ADDRESS=0.0.0.0 only if you know nothing else guards the port.
PORT=8011
BIND_ADDRESS=127.0.0.1

# Timezone for the schedulers and the voice agent.
TZ=America/New_York

# Shared secret for /api/voice/* — the only routes the voice agent must reach
# without going through your proxy's authentication. Generate one with:
#   openssl rand -hex 32
# Leave blank only on a laptop or a private network: blank means those routes
# accept requests from anyone who can reach the server.
VOICE_API_TOKEN=

# ── Database ──────────────────────────────────────────────────────────────────
# Optional: Turso cloud database.
# If both vars are set, the app uses Turso instead of the local SQLite file.
# Leave blank (or omit) to use local SQLite at data/task-light.db.
TURSO_DB_URL=
TURSO_API_KEY=

# ── Telegram bot ──────────────────────────────────────────────────────────────
# Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your Telegram user ID — only this user can interact with the bot.
# Find it by messaging @userinfobot on Telegram.
BOT_HOST_ID=

# ── AI provider ───────────────────────────────────────────────────────────────
# Anthropic takes priority if both are set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Voice calls (xAI) ─────────────────────────────────────────────────────────
# API key from console.x.ai. Required for any voice feature.
XAI_API_KEY=

# The agent from the xAI Voice Agent Builder (console.x.ai -> Voice -> Agents).
# Its prompt and tools are configured there; `deno task calls:tools` prints
# what to paste in. Without it, outbound reminder calls are disabled.
XAI_AGENT_ID=

# Optional: which of the agent's numbers to call from, when it has more than one.
XAI_FROM_NUMBER=

# The number reminder calls go to (yours), in E.164 format.
REMINDER_TO_NUMBER=

# Signing secret xAI returns once when a phone number is registered with a
# webhook. Set it to have /api/voice/webhook verify incoming events.
XAI_WEBHOOK_SECRET=

# Only if xAI moves the outbound-call endpoint. Default: /v1/realtime/calls
XAI_OUTBOUND_PATH=

# Public URL of this app — the voice agent's tools and webhook point at it
# (e.g. https://your-domain.com or an ngrok URL).
APP_BASE_URL=
